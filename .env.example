# --- Application ---
ENVIRONMENT=dev
LOG_LEVEL=INFO
LATENCY_BUDGET_MS=1500

# --- Provider selection (Strategy) ---
# Until Deepgram / ElevenLabs keys arrive, you can run the whole pipeline
# on just OPENAI_API_KEY (Whisper STT + tts-1). Switch to deepgram /
# elevenlabs later for lower latency.
STT_PROVIDER=openai          # openai | deepgram | local_http | mock
LLM_PROVIDER=openai          # openai | local_http | mock
TTS_PROVIDER=openai          # openai | elevenlabs | local_http | mock

# --- Локальные HTTP-провайдеры (OpenAI-совместимый LLM, свой ASR/TTS) ---
LOCAL_LLM_BASE_URL=          # http://ollama-host:11434
LOCAL_LLM_API_KEY=
LOCAL_LLM_CHAT_MODEL=llama3.2
LOCAL_LLM_EMBED_MODEL=nomic-embed-text
LOCAL_STT_URL=               # POST multipart file=WAV
LOCAL_TTS_URL=               # POST JSON {text, voice_id, locale}
PYANNOTE_WORKER_URL=         # POST file → JSON {turns:[{speaker,text,start_sec,end_sec}]}

# --- Deepgram (STT) ---
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-2-general
DEEPGRAM_LANGUAGE=ru

# --- OpenAI (LLM + embeddings + TTS + Whisper) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIM=1536
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=alloy            # alloy | echo | fable | onyx | nova | shimmer
OPENAI_TTS_FORMAT=mp3
OPENAI_STT_MODEL=whisper-1
OPENAI_STT_FLUSH_MS=1200
OPENAI_STT_SILENCE_MS=700

# --- ElevenLabs (TTS) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_MODEL=eleven_turbo_v2_5

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=voiceagent
POSTGRES_USER=voiceagent
POSTGRES_PASSWORD=voiceagent

# --- Diarization (речевая аналитика; HTTP без изменений) ---
# llm | deepgram | pyannote | mock
DIARIZATION_PROVIDER=llm

# --- Qdrant ---
QDRANT_HOST=qdrant
QDRANT_PORT=6333
# Два пула: голосовой бот и суфлёр (разные коллекции в Qdrant).
QDRANT_COLLECTION=knowledge_base
QDRANT_COLLECTION_VOICE=knowledge_base
QDRANT_COLLECTION_AGENT_ASSIST=knowledge_agent_assist
